{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_DOCKER_HOST",
        "EXPO_PUBLIC_SOCKET_URL": "https://YOUR_DOCKER_HOST"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_DOCKER_HOST",
        "EXPO_PUBLIC_SOCKET_URL": "https://YOUR_DOCKER_HOST"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_DOCKER_HOST",
        "EXPO_PUBLIC_SOCKET_URL": "https://YOUR_DOCKER_HOST"
      }
    }
  },
  "submit": { "production": {} }
}
