# For deploy: use your hosted Postgres pooled URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/db?sslmode=require"
# Redis (Upstash/Redis Cloud) - full URL required
REDIS_URL="redis://default:PASSWORD@HOST:PORT"
JWT_SECRET="generate-a-long-random-string-min-32-chars"
AGORA_APP_ID="731fdb4dd3854cc99163a92c35d584b0"
AGORA_APP_CERTIFICATE="your-agora-certificate-keep-secret"
PORT=4000
# For production, set to your frontend/expo origin or * for test
CLIENT_ORIGIN="*"
